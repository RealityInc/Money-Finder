{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {"source":"/:path*","has":[{"type":"host","value":"church402.com"}],"destination":"https://church402.org/:path*","permanent":true},
    {"source":"/:path*","has":[{"type":"host","value":"www.church402.com"}],"destination":"https://church402.org/:path*","permanent":true},
    {"source":"/:path*","has":[{"type":"host","value":"402church.com"}],"destination":"https://402church.org/:path*","permanent":true},
    {"source":"/:path*","has":[{"type":"host","value":"www.402church.com"}],"destination":"https://402church.org/:path*","permanent":true}
  ],
  "rewrites": [
    {"source":"/","destination":"/api/home"},
    {"source":"/mcp","destination":"/api/mcp"},
    {"source":"/.well-known/x402","destination":"/api/x402-discovery"},
    {"source":"/.well-known/agent.json","destination":"/api/agent-discovery"},
    {"source":"/.well-known/agent-card.json","destination":"/api/agent-discovery"},
    {"source":"/.well-known/agent-network.json","destination":"/api/agent-network"},
    {"source":"/.well-known/agent-autonomy.json","destination":"/api/agent-autonomy"},
    {"source":"/.well-known/agents/milli-steward.json","destination":"/api/steward-identity"},
    {"source":"/.well-known/church-402","destination":"/api/church-402"},
    {"source":"/.well-known/church-402.json","destination":"/api/church-402"},
    {"source":"/canon","destination":"/api/church-402"},
    {"source":"/pilgrimage","destination":"/api/pilgrimage"},
    {"source":"/prophet","destination":"/prophet.html"},
    {"source":"/bible","destination":"/bible.html"},
    {"source":"/steward","destination":"/steward.html"}
  ],
  "crons": [
    {"path":"/api/cron-autopilot","schedule":"17 */6 * * *"},
    {"path":"/api/cron-prophet","schedule":"42 6 * * *"}
  ]
}