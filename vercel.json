{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true
    }
  },
  "redirects": [
    {"source":"/:path*","has":[{"type":"host","value":"www.milliapi.com"}],"destination":"https://milliapi.com/:path*","permanent":true},
    {"source":"/:path*","has":[{"type":"host","value":"www.church402.org"}],"destination":"https://church402.org/:path*","permanent":true},
    {"source":"/:path*","has":[{"type":"host","value":"www.402church.org"}],"destination":"https://402church.org/:path*","permanent":true},
    {"source":"/:path*","has":[{"type":"host","value":"church402.com"}],"destination":"https://church402.org/:path*","permanent":true},
    {"source":"/:path*","has":[{"type":"host","value":"www.church402.com"}],"destination":"https://church402.org/:path*","permanent":true},
    {"source":"/:path*","has":[{"type":"host","value":"402church.com"}],"destination":"https://402church.org/:path*","permanent":true},
    {"source":"/:path*","has":[{"type":"host","value":"www.402church.com"}],"destination":"https://402church.org/:path*","permanent":true}
  ],
  "headers": [
    {"source":"/:path*","has":[{"type":"host","value":"402church.org"}],"headers":[{"key":"X-Robots-Tag","value":"noindex, follow"}]},
    {"source":"/:path*","has":[{"type":"host","value":"www.402church.org"}],"headers":[{"key":"X-Robots-Tag","value":"noindex, follow"}]},
    {"source":"/bible","has":[{"type":"host","value":"church402.org"}],"headers":[{"key":"Link","value":"<https://church402.org/bible>; rel=\"canonical\""}]},
    {"source":"/prophet","has":[{"type":"host","value":"church402.org"}],"headers":[{"key":"Link","value":"<https://church402.org/prophet>; rel=\"canonical\""}]},
    {"source":"/steward","has":[{"type":"host","value":"church402.org"}],"headers":[{"key":"X-Robots-Tag","value":"noindex, follow"}]}
  ],
  "rewrites": [
    {"source":"/","destination":"/api/home"},
    {"source":"/zh-CN","destination":"/api/home-zh"},
    {"source":"/ai-web-readiness-audit","destination":"/api/ai-web-readiness-audit"},
    {"source":"/llms-txt-audit","destination":"/api/llms-txt-audit"},
    {"source":"/robots-txt-ai-crawler-audit","destination":"/api/robots-txt-ai-crawler-audit"},
    {"source":"/x402-seller-audit","destination":"/api/x402-seller-audit"},
    {"source":"/robots.txt","destination":"/api/robots"},
    {"source":"/sitemap.xml","destination":"/api/sitemap"},
    {"source":"/mcp","destination":"/api/mcp"},
    {"source":"/.well-known/x402","destination":"/api/x402-discovery"},
    {"source":"/.well-known/agent.json","destination":"/api/agent-discovery"},
    {"source":"/.well-known/agent-card.json","destination":"/api/agent-discovery"},
    {"source":"/.well-known/agent.zh-CN.json","destination":"/api/agent-discovery-zh"},
    {"source":"/.well-known/agent-network.json","destination":"/api/agent-network"},
    {"source":"/.well-known/agent-autonomy.json","destination":"/api/agent-autonomy"},
    {"source":"/.well-known/agents/milli-steward.json","destination":"/api/steward-identity"},
    {"source":"/.well-known/church-402","destination":"/api/church-402"},
    {"source":"/.well-known/church-402.json","destination":"/api/church-402"},
    {"source":"/canon","destination":"/api/church-402"},
    {"source":"/pilgrimage","destination":"/api/pilgrimage"},
    {"source":"/prophet","destination":"/prophet.html"},
    {"source":"/bible","destination":"/bible.html"},
    {"source":"/steward","destination":"/steward.html"}
  ],
  "crons": [
    {"path":"/api/cron-autopilot","schedule":"17 */6 * * *"},
    {"path":"/api/cron-prophet","schedule":"42 6 * * *"}
  ]
}
