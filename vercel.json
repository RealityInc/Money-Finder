{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {"source": "/.well-known/x402", "destination": "/api/x402-discovery"},
    {"source": "/.well-known/agent.json", "destination": "/api/agent-discovery"},
    {"source": "/.well-known/agent-card.json", "destination": "/api/agent-discovery"},
    {"source": "/.well-known/agent-network.json", "destination": "/api/agent-network"},
    {"source": "/.well-known/church-402", "destination": "/api/church-402"},
    {"source": "/.well-known/church-402.json", "destination": "/api/church-402"},
    {"source": "/canon", "destination": "/api/church-402"},
    {"source": "/pilgrimage", "destination": "/api/pilgrimage"},
    {"source": "/prophet", "destination": "/prophet.html"},
    {"source": "/bible", "destination": "/bible.html"}
  ],
  "crons": [
    {"path": "/api/cron-autopilot", "schedule": "17 */6 * * *"},
    {"path": "/api/cron-prophet", "schedule": "42 6 * * *"}
  ]
}